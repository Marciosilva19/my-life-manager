# --- Supabase -------------------------------------------------------------
# Painel Supabase > Project Settings > Data API / API Keys

# URL do projeto (ex.: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave "service_role". É usada APENAS no servidor (Server Components e
# Server Actions). Nunca é enviada para o browser. Não usar prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Chave "anon" (opcional nesta fase; reservada para quando houver autenticação)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
