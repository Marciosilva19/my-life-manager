# --- Supabase -------------------------------------------------------------
# Painel Supabase > Project Settings > Data API / API Keys

# URL do projeto (ex.: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave secreta do servidor. Nos projetos novos chama-se "secret key" e começa
# por sb_secret_ (Project Settings > API Keys > Secret keys); nos projetos mais
# antigos é a "service_role". Qualquer uma funciona — ambas ignoram o RLS.
# É usada APENAS no servidor (Server Components e Server Actions), nunca é
# enviada para o browser, e não deve ter o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Chave pública (opcional nesta fase; reservada para quando houver autenticação).
# Nos projetos novos é a "publishable key" (sb_publishable_...), nos antigos a "anon".
NEXT_PUBLIC_SUPABASE_ANON_KEY=
